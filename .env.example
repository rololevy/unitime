# Copiá este archivo a .env.local y completalo. Nunca subas .env.local al repo.

# URL pública del sitio (metadatos, sitemap). En Vercel: el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---------------------------------
# URL del proyecto. El servidor la lee en runtime.
SUPABASE_URL=http://127.0.0.1:54321
# Misma URL para el navegador (queda fija en el build).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_…): pública, respeta RLS. La usan el login y la sesión.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…) o service_role legacy. Saltea RLS: SOLO servidor,
# jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile (anti-bots) ----------------------------------------
# Opcional en desarrollo. En producción es muy recomendable (gratis).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
